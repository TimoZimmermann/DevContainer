ROS_DOMAIN_ID=42
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
DISPLAY=:0

# Pfad relativ zum compose-Ordner.
# Annahme:
# workspace/
# ├── DevContainer-main/
# │   └── compose/
# └── FloriBot4.0_ROS2_Jazzy_Base-main/
FLORIBOT_BASE_REPO_PATH=../../FloriBot4.0_ROS2_Jazzy_Base-main

# Fest gepinnter robot_localization Commit.
# Beispielwert ersetzen.
ROBOT_LOCALIZATION_SHA=<FIXED_COMMIT_SHA>

LOCALIZATION_CONFIG=/ws/config/localization/local_ekf.yaml

# Interaktive Shell:
LOCALIZATION_COMMAND=bash

# Nur EKF starten:
# LOCALIZATION_COMMAND=ros2 run robot_localization ekf_node --ros-args --params-file /ws/config/localization/local_ekf.yaml

# Base + EKF starten:
# Wichtig: Dafür muss base_node publish_tf:=false unterstützen.
# LOCALIZATION_COMMAND=ros2 launch base base_node.launch.py publish_tf:=false
